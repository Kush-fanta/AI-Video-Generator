{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varnam/contracts/capability-registry.schema.json",
  "title": "Varnam Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_status",
    "registry_date",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "registry_status": {
      "type": "string",
      "const": "experimental"
    },
    "registry_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "stage",
        "owner_lane",
        "status",
        "intents",
        "requires",
        "outputs",
        "authority_inputs",
        "native_surfaces",
        "verification",
        "fallback_or_block"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "authoring",
            "research",
            "review",
            "composition",
            "audio",
            "visual",
            "motion",
            "maps",
            "workspace"
          ]
        },
        "owner_lane": {
          "type": "string",
          "enum": [
            "editor",
            "core",
            "researcher",
            "reviewer",
            "audio",
            "visual",
            "mograph",
            "maps"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "partial",
            "stub",
            "deferred"
          ]
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "native_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_or_block": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
