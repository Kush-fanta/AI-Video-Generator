    "projection": "Mercator, fitExtent [[20,20],[1490,800]] on 1510×820 canvas",
    "viewbox": "0 0 1510 820",
    "layers": ["outline", "states (36)", "districts (785)", "acs (4177)", "metros (28)"],
    "license": "CC0 1.0",
    "use": "Single source for India boundary, admin polygons, and metro coordinates inside the Remotion runtime. Pass outline + viewbox into geo/city-markers.tsx for India city overlays — do not author new India-specific components."
  },
