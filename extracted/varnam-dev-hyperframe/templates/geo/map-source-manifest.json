{
  "schema": 1,
  "notes": [
    "Use Survey of India / LGD-derived India assets for India-focused maps.",
    "Use world-atlas for the world base, but never as the featured India boundary.",
    "Use geo/generate-varnam-world-geo.py and geo/generate-varnam-world-map.mjs to regenerate the canonical world-map asset surface.",
    "geo/india.json is the canonical runtime India source: outline, viewbox, projection, states, districts, ACs, metros, all pre-projected to the 1510×820 Mercator canvas with centroids. Import via geo/india-paths.ts. Do not re-derive coordinates per-project; look them up."
  ],
  "india_runtime": {
    "id": "india-canonical-runtime",
    "file": "geo/india.json",
